<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="460.0" spacing="14.0" style="-fx-background-color: #ffffff; -fx-padding: 24px;" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.controllers.ExpenseDialogController">
   <children>
      <!-- Dialog Header -->
      <VBox spacing="4.0" style="-fx-padding: 0 0 8px 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;">
         <children>
            <Label fx:id="lblDialogTitle" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Add New Expense" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Enter the transaction details to record in your ledger" />
         </children>
      </VBox>

      <!-- Field: Title -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Expense Title *" />
            <TextField fx:id="txtTitle" promptText="e.g. Grocery Shopping, Metro Pass" />
         </children>
      </VBox>

      <!-- Field: Amount & Category in an HBox -->
      <HBox spacing="12.0">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Amount (₹) *" />
                  <TextField fx:id="txtAmount" promptText="e.g. 500.00" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Category *" />
                  <ComboBox fx:id="comboCategory" maxWidth="1.7976931348623157E308" promptText="Select category" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Field: Date -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Date *" />
            <DatePicker fx:id="dpDate" maxWidth="1.7976931348623157E308" promptText="Select date" />
         </children>
      </VBox>

      <!-- Field: Description -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Description (Optional)" />
            <TextArea fx:id="txtDescription" prefRowCount="3" promptText="Add optional notes, store name, or receipt info..." wrapText="true" />
         </children>
      </VBox>

      <!-- Validation Error Feedback -->
      <Label fx:id="lblError" styleClass="error-label" text="" visible="false" wrapText="true" />

      <!-- Dialog Action Buttons -->
      <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 8px 0 0 0;">
         <children>
            <Button fx:id="btnCancel" onAction="#handleCancel" styleClass="btn-secondary" text="Cancel" />
            <Button fx:id="btnSave" onAction="#handleSave" styleClass="btn-primary" text="Save Expense" />
         </children>
      </HBox>
   </children>
</VBox>

