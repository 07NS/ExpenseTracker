<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.controllers.TransactionsController">
   <children>
      <!-- Header with Add Expense button -->
      <HBox alignment="CENTER_LEFT" styleClass="view-header">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="view-title" text="Transactions" />
                  <Label styleClass="view-subtitle" text="Review, search, filter, and manage all your expense records" />
               </children>
            </VBox>
            <Button fx:id="btnAddExpense" onAction="#handleOpenAddDialog" styleClass="btn-primary" text="➕  Add Expense" />
         </children>
      </HBox>

      <!-- Filter / Search Bar Panel -->
      <VBox styleClass="panel" spacing="12.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtSearch" prefWidth="260.0" promptText="🔍  Search by title or description..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFilterCategory" prefWidth="150.0" promptText="Category" />
                  <DatePicker fx:id="dpFromDate" prefWidth="140.0" promptText="From date" />
                  <DatePicker fx:id="dpToDate" prefWidth="140.0" promptText="To date" />
                  <Button fx:id="btnResetFilter" onAction="#handleResetFilters" styleClass="btn-secondary" text="Reset" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Transactions Table Panel -->
      <VBox styleClass="panel" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colTitle" prefWidth="200.0" text="Title" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colAmount" prefWidth="120.0" text="Amount (₹)" />
                  <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                  <TableColumn fx:id="colDescription" prefWidth="240.0" text="Description" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Table Footer Actions -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 14px 0 0 0;">
               <children>
                  <Label fx:id="lblRecordCount" style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Total records: 0" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnEdit" onAction="#handleEditSelected" styleClass="btn-secondary" text="✏️  Edit Selected" />
                  <Button fx:id="btnDelete" onAction="#handleDeleteSelected" styleClass="btn-danger" text="🗑️  Delete Selected" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>

